DB_USER= # Usuario de base de datos
DB_HOST= # Ambiente en el que se encuentra la base de datos. localhost para ambiente de pruebas.
DB_NAME= # Nombre base de datos.
DB_PASSWORD= # Contraseña de base de datos.
DB_PORT= # Puerto de base de datos. 5432 por defecto en ambiente de pruebas.
# Conexión con render.
DB_SSL=false

JWT_SECRET= # Llave única que debe ser generada en CMD/Powershell. Se recomienda crear una con node.
JWT_EXPIRES_IN=8h # Tiempo de expiración del token.