DB_USER=postgres
DB_HOST=localhost
DB_NAME= # Nombre base de datos local.
DB_PASSWORD= # Contraseña de base de datos local.
DB_PORT=5432 # Viene por default al configurar un servidor y base de datos.

JWT_SECRET= # Crear llave JWT propia. Para ello, se puede correr la siguiente en powershell o cmd del backend-express
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_EXPIRES_IN=8h